<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Main application theme -->
    <style name="Theme.ComradeBite" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">#05080C</item>
        <item name="android:statusBarColor">#05080C</item>
        <item name="android:navigationBarColor">#05080C</item>
    </style>

    <!-- Transition Splash Screen -->
    <style name="Theme.App.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#05080C</item>
        <!-- Transparent system icon to let the custom design take over instantly -->
        <item name="windowSplashScreenAnimatedIcon">@android:color/transparent</item>
        <item name="postSplashScreenTheme">@style/Theme.ComradeBite</item>
    </style>
</resources>
